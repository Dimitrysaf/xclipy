#: xclipy/ui/clipboard_page.py:372
msgid "Save"
msgstr "Αποθήκευση"

#: xclipy/ui/emoji_page.py:66
msgid "Recently used"
msgstr "Πρόσφατα"

#: xclipy/ui/emoji_page.py:89
msgid "Emoji you use show up here."
msgstr "Τα emoji που χρησιμοποιείτε εμφανίζονται εδώ."

#: xclipy/ui/emoji_page.py:100
msgid "No emoji found"
msgstr "Δεν βρέθηκαν emoji"

#: xclipy/ui/search_bar.py:14
msgid "Search"
msgstr "Αναζήτηση"

#: xclipy/ui/settings_page.py:22
msgid "They are also listed in Keyboard, under Shortcuts → Custom Shortcuts."
msgstr ""
"Εμφανίζονται επίσης στο Πληκτρολόγιο, στις Συντομεύσεις → Προσαρμοσμένες "
"συντομεύσεις."

#: xclipy/ui/settings_page.py:23
msgid "They are also listed in Keyboard Shortcuts, under Custom Shortcuts."
msgstr ""
"Εμφανίζονται επίσης στις Συντομεύσεις πληκτρολογίου, στις Προσαρμοσμένες "
"συντομεύσεις."

#: xclipy/ui/settings_page.py:24
msgid "They are also listed in Keyboard, under Application Shortcuts."
msgstr "Εμφανίζονται επίσης στο Πληκτρολόγιο, στις Συντομεύσεις εφαρμογών."

#: xclipy/ui/settings_page.py:31
msgid "Enable clipboard history"
msgstr "Ενεργοποίηση ιστορικού προχείρου"

#: xclipy/ui/settings_page.py:37
msgid "Keyboard shortcuts"
msgstr "Συντομεύσεις πληκτρολογίου"

#: xclipy/ui/settings_page.py:39
msgid "Open the clipboard history"
msgstr "Άνοιγμα του ιστορικού προχείρου"

#: xclipy/ui/settings_page.py:40
msgid "Open the emojis"
msgstr "Άνοιγμα των emoji"

#: xclipy/ui/settings_page.py:44
msgid ""
"Set them in your desktop's keyboard settings: “xclipy --show” opens the "
"clipboard history and “xclipy --emoji” the emojis."
msgstr ""
"Ορίστε τις στις ρυθμίσεις πληκτρολογίου της επιφάνειας εργασίας σας: το "
"«xclipy --show» ανοίγει το ιστορικό προχείρου και το «xclipy --emoji» τα "
"emoji."

#: xclipy/ui/settings_page.py:47
msgid "History"
msgstr "Ιστορικό"

#: xclipy/ui/settings_page.py:48
msgid "Number of recent items"
msgstr "Πλήθος πρόσφατων στοιχείων"

#: xclipy/ui/settings_page.py:49
msgid "Paste the chosen item"
msgstr "Επικόλληση του στοιχείου που επιλέγετε"

#: xclipy/ui/settings_page.py:50
msgid "Show item types"
msgstr "Εμφάνιση του είδους των στοιχείων"

#: xclipy/ui/settings_page.py:51
msgid "Show search bar"
msgstr "Εμφάνιση γραμμής αναζήτησης"

#: xclipy/ui/settings_page.py:52
msgid "Keep copied images"
msgstr "Διατήρηση εικόνων που αντιγράφονται"

#: xclipy/ui/settings_page.py:53
msgid "Clear recent items when logging out"
msgstr "Εκκαθάριση πρόσφατων στοιχείων κατά την αποσύνδεση"

#: xclipy/ui/settings_page.py:54
msgid "Delete old recent items"
msgstr "Διαγραφή παλιών πρόσφατων στοιχείων"

#: xclipy/ui/settings_page.py:55
msgid "Older than"
msgstr "Παλιότερα από"

#: xclipy/ui/settings_page.py:55
msgid "days"
msgstr "ημέρες"

#: xclipy/ui/settings_page.py:57
msgid "Clear history"
msgstr "Εκκαθάριση ιστορικού"

#: xclipy/ui/settings_page.py:60
msgid "Hide passwords"
msgstr "Απόκρυψη κωδικών πρόσβασης"

#: xclipy/ui/settings_page.py:61
msgid "Treat random-looking text as a password"
msgstr "Αντιμετώπιση κειμένου που μοιάζει τυχαίο ως κωδικού πρόσβασης"

#: xclipy/ui/settings_page.py:63
msgid "Delete passwords once pasted"
msgstr "Διαγραφή κωδικών πρόσβασης μόλις επικολληθούν"

#: xclipy/ui/settings_page.py:64
msgid "Forget passwords after a while"
msgstr "Διαγραφή κωδικών πρόσβασης μετά από λίγο"

#: xclipy/ui/settings_page.py:66
msgid "After"
msgstr "Μετά από"

#: xclipy/ui/settings_page.py:66
msgid "minutes"
msgstr "λεπτά"

#: xclipy/ui/settings_page.py:68
msgid "Save pinned passwords in Passwords and Keys"
msgstr "Αποθήκευση καρφιτσωμένων κωδικών στο «Κωδικοί πρόσβασης και κλειδιά»"

#: xclipy/ui/settings_page.py:70
msgid ""
"Passwords are recognised when the application copying them says so, as "
"password managers like KeePassXC do, or when they look random, like "
"generated passwords and keys. They are only saved in your keyring, when "
"pinned and the option above is on."
msgstr ""
"Οι κωδικοί πρόσβασης αναγνωρίζονται όταν το επισημαίνει η εφαρμογή που τους "
"αντιγράφει, όπως κάνουν διαχειριστές κωδικών σαν το KeePassXC, ή όταν "
"μοιάζουν τυχαίοι, όπως οι κωδικοί και τα κλειδιά που δημιουργούνται "
"αυτόματα. Αποθηκεύονται μόνο στην κλειδοθήκη σας, όταν είναι καρφιτσωμένοι "
"και η παραπάνω επιλογή είναι ενεργή."

#: xclipy/ui/settings_page.py:78
msgid "Excluded applications"
msgstr "Εξαιρούμενες εφαρμογές"

#: xclipy/ui/settings_page.py:80
msgid "What these applications copy is never kept."
msgstr "Ό,τι αντιγράφουν αυτές οι εφαρμογές δεν διατηρείται ποτέ."

#: xclipy/ui/settings_page.py:83
msgid "Show emojis"
msgstr "Εμφάνιση των emoji"

#: xclipy/ui/settings_page.py:84
msgid "Default"
msgstr "Προεπιλογή"

#: xclipy/ui/settings_page.py:84
msgid "Light"
msgstr "Ανοιχτός"

#: xclipy/ui/settings_page.py:84
msgid "Medium-light"
msgstr "Μεσαίος προς ανοιχτό"

#: xclipy/ui/settings_page.py:85
msgid "Medium"
msgstr "Μεσαίος"

#: xclipy/ui/settings_page.py:85
msgid "Medium-dark"
msgstr "Μεσαίος προς σκούρο"

#: xclipy/ui/settings_page.py:85
msgid "Dark"
msgstr "Σκούρος"

#: xclipy/ui/settings_page.py:86
msgid "Skin tone"
msgstr "Τόνος δέρματος"

#: xclipy/ui/settings_page.py:111
msgid ""
"Click, then press the new keys. Escape cancels, Backspace removes the "
"shortcut."
msgstr ""
"Κάντε κλικ και πατήστε τα νέα πλήκτρα. Το Escape ακυρώνει, το Backspace "
"αφαιρεί τη συντόμευση."

#: xclipy/ui/settings_page.py:123
msgid "New shortcut…"
msgstr "Νέα συντόμευση…"

#: xclipy/ui/settings_page.py:128
msgid "None"
msgstr "Καμία"

#: xclipy/ui/settings_page.py:177
msgid "Add an application…"
msgstr "Προσθήκη εφαρμογής…"

#: xclipy/ui/settings_page.py:188
msgid "No applications"
msgstr "Καμία εφαρμογή"

#: xclipy/ui/settings_page.py:199
msgid "Remove"
msgstr "Αφαίρεση"

#: xclipy/ui/settings_page.py:217
msgid "Add an application"
msgstr "Προσθήκη εφαρμογής"

#: xclipy/ui/settings_page.py:220
msgid "Add"
msgstr "Προσθήκη"

#: xclipy/ui/settings_page.py:227
msgid "Search applications"
msgstr "Αναζήτηση εφαρμογών"

#: xclipy/xclipy.py:46
msgid "Keep the clipboard history without opening it"
msgstr "Διατήρηση του ιστορικού προχείρου χωρίς να ανοίξει"

#: xclipy/xclipy.py:49
msgid "Open the clipboard history, or close it when it is open"
msgstr "Άνοιγμα του ιστορικού προχείρου ή κλείσιμό του όταν είναι ανοιχτό"

#: xclipy/xclipy.py:52
msgid "Open the emojis, or close them when they are open"
msgstr "Άνοιγμα των emoji ή κλείσιμό τους όταν είναι ανοιχτά"

#: xclipy/xclipy.py:55
msgid "Open the settings"
msgstr "Άνοιγμα των ρυθμίσεων"
