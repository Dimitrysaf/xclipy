#: data/cinnamon-settings-xclipy.desktop.in:4 cinnamon-settings/cs_xclipy.py:32
#: xclipy/ui/overlay.py:80
msgid "Clipboard"
msgstr "Πρόχειρο"

#: data/cinnamon-settings-xclipy.desktop.in:5 cinnamon-settings/cs_xclipy.py:27
msgid "Clipboard history and emoji"
msgstr "Ιστορικό προχείρου και emoji"

#: data/cinnamon-settings-xclipy.desktop.in:11 data/org.x.Xclipy.desktop.in:12
msgid "clipboard;history;copy;paste;emoji;"
msgstr ""
"πρόχειρο;ιστορικό;αντιγραφή;επικόλληση;emoji;clipboard;history;copy;paste;"

#: data/org.x.Xclipy-autostart.desktop.in:4 data/org.x.Xclipy.desktop.in:4
msgid "Clipboard History"
msgstr "Ιστορικό προχείρου"

#: data/org.x.Xclipy-autostart.desktop.in:5
msgid "Keep the clipboard history"
msgstr "Διατήρηση του ιστορικού προχείρου"

#: data/org.x.Xclipy.desktop.in:5
msgid "Paste something you copied earlier, or an emoji"
msgstr "Επικολλήστε κάτι που αντιγράψατε νωρίτερα ή ένα emoji"

#: cinnamon-settings/cs_xclipy.py:31
msgid "clipboard, history, copy, paste, emoji"
msgstr ""
"πρόχειρο, ιστορικό, αντιγραφή, επικόλληση, emoji, clipboard, history, copy, "
"paste"

#: cinnamon-settings/cs_xclipy.py:41
msgid "Enable clipboard history"
msgstr "Ενεργοποίηση ιστορικού προχείρου"

#: cinnamon-settings/cs_xclipy.py:47
msgid "Keyboard shortcuts"
msgstr "Συντομεύσεις πληκτρολογίου"

#: cinnamon-settings/cs_xclipy.py:48
msgid "Open the clipboard history"
msgstr "Άνοιγμα του ιστορικού προχείρου"

#: cinnamon-settings/cs_xclipy.py:49
msgid "Open the emojis"
msgstr "Άνοιγμα των emoji"

#: cinnamon-settings/cs_xclipy.py:50
msgid "They are also listed in Keyboard, under Shortcuts → Custom Shortcuts."
msgstr "Εμφανίζονται επίσης στο Πληκτρολόγιο, στις Συντομεύσεις → Προσαρμοσμένες συντομεύσεις."

#: cinnamon-settings/cs_xclipy.py:52
msgid "History"
msgstr "Ιστορικό"

#: cinnamon-settings/cs_xclipy.py:53
msgid "Number of recent items"
msgstr "Πλήθος πρόσφατων στοιχείων"

#: cinnamon-settings/cs_xclipy.py:54
msgid "Paste the chosen item"
msgstr "Επικόλληση του στοιχείου που επιλέγετε"

#: cinnamon-settings/cs_xclipy.py:55
msgid "Show item types"
msgstr "Εμφάνιση του είδους των στοιχείων"

#: cinnamon-settings/cs_xclipy.py:56
msgid "Show search bar"
msgstr "Εμφάνιση γραμμής αναζήτησης"

#: cinnamon-settings/cs_xclipy.py:57
msgid "Keep copied images"
msgstr "Διατήρηση εικόνων που αντιγράφονται"

#: cinnamon-settings/cs_xclipy.py:58
msgid "Clear recent items when logging out"
msgstr "Εκκαθάριση πρόσφατων στοιχείων κατά την αποσύνδεση"

#: cinnamon-settings/cs_xclipy.py:59
msgid "Delete old recent items"
msgstr "Διαγραφή παλιών πρόσφατων στοιχείων"

#: cinnamon-settings/cs_xclipy.py:60
msgid "Older than"
msgstr "Παλιότερα από"

#: cinnamon-settings/cs_xclipy.py:60
msgid "days"
msgstr "ημέρες"

#: cinnamon-settings/cs_xclipy.py:62
msgid "Clear history"
msgstr "Εκκαθάριση ιστορικού"

#: cinnamon-settings/cs_xclipy.py:64 xclipy/ui/clipboard_page.py:27
msgid "Passwords"
msgstr "Κωδικοί πρόσβασης"

#: cinnamon-settings/cs_xclipy.py:65
msgid "Hide passwords"
msgstr "Απόκρυψη κωδικών πρόσβασης"

#: cinnamon-settings/cs_xclipy.py:66
msgid "Treat random-looking text as a password"
msgstr "Αντιμετώπιση κειμένου που μοιάζει τυχαίο ως κωδικού πρόσβασης"

#: cinnamon-settings/cs_xclipy.py:68
msgid "Delete passwords once pasted"
msgstr "Διαγραφή κωδικών πρόσβασης μόλις επικολληθούν"

#: cinnamon-settings/cs_xclipy.py:69
msgid "Forget passwords after a while"
msgstr "Διαγραφή κωδικών πρόσβασης μετά από λίγο"

#: cinnamon-settings/cs_xclipy.py:71
msgid "After"
msgstr "Μετά από"

#: cinnamon-settings/cs_xclipy.py:71
msgid "minutes"
msgstr "λεπτά"

#: cinnamon-settings/cs_xclipy.py:73
msgid "Save pinned passwords in Passwords and Keys"
msgstr "Αποθήκευση καρφιτσωμένων κωδικών στο «Κωδικοί πρόσβασης και κλειδιά»"

#: cinnamon-settings/cs_xclipy.py:75
msgid ""
"Passwords are recognised when the application copying them says so, as "
"password managers like KeePassXC do, or when they look random, like "
"generated passwords and keys. They are only saved in your keyring, when "
"pinned and the option above is on."
msgstr "Οι κωδικοί πρόσβασης αναγνωρίζονται όταν το επισημαίνει η εφαρμογή που τους αντιγράφει, όπως κάνουν διαχειριστές κωδικών σαν το KeePassXC, ή όταν μοιάζουν τυχαίοι, όπως οι κωδικοί και τα κλειδιά που δημιουργούνται αυτόματα. Αποθηκεύονται μόνο στην κλειδοθήκη σας, όταν είναι καρφιτσωμένοι και η παραπάνω επιλογή είναι ενεργή."

#: cinnamon-settings/cs_xclipy.py:82
msgid "Excluded applications"
msgstr "Εξαιρούμενες εφαρμογές"

#: cinnamon-settings/cs_xclipy.py:84
msgid "What these applications copy is never kept."
msgstr "Ό,τι αντιγράφουν αυτές οι εφαρμογές δεν διατηρείται ποτέ."

#: cinnamon-settings/cs_xclipy.py:86 xclipy/shortcut.py:29
